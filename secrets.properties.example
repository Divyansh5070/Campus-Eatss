# ============================================================
#  secrets.properties.example
#  Copy this file to secrets.properties and fill in your values.
#  ⚠️  secrets.properties is in .gitignore — NEVER commit it.
# ============================================================

# Android Keystore (for release signing)
KEYSTORE_FILE=upload-keystore.jks
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_ALIAS=upload
KEY_PASSWORD=your_key_password_here

# OneSignal Push Notifications App ID
# Get this from https://app.onesignal.com → Your App → Keys & IDs
ONESIGNAL_APP_ID=your_onesignal_app_id_here

# Google OAuth Web Client ID
# Get this from Firebase Console → Authentication → Sign-in method → Google → Web client ID
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Firebase Realtime Database URL
# Get this from Firebase Console → Realtime Database → Data tab (URL at the top)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
