@Composable
fun MealTypeCard(
    mealType: String,
    meals: List<Meal>,
    navController: NavController,
    isDarkTheme: Boolean,
    surfaceColor: Color,
    textColor: Color,
    textSecondaryColor: Color,
    dividerColor: Color
) {
    val primaryOrange = Color(0xFFFF6B01)

    // Enhanced meal icons with more visually appealing emojis
    val mealIcon = when (mealType.lowercase()) {
        "breakfast" -> "🍳"
        "lunch" -> "🍛"
        "snacks" -> "🧁"
        "dinner" -> "🍽️"
        else -> "🍴"
    }

    // Time ranges for each meal type
    val timeRange = when (mealType.lowercase()) {
        "breakfast" -> "7:30 AM - 9:30 AM"
        "lunch" -> "12:30 PM - 2:30 PM"
        "snacks" -> "4:30 PM - 6:00 PM"
        "dinner" -> "7:30 PM - 9:30 PM"
        else -> ""
    }

    // Background colors for meal type icons - adapted for dark theme
    val iconBackground = when (mealType.lowercase()) {
        "breakfast" -> if (isDarkTheme) Color(0xFF3D3500) else Color(0xFFFFF8E1) // Yellow
        "lunch" -> if (isDarkTheme) Color(0xFF002B45) else Color(0xFFE3F2FD) // Blue
        "snacks" -> if (isDarkTheme) Color(0xFF4A0072) else Color(0xFFE1BEE7)
        "dinner" -> if (isDarkTheme) Color(0xFF003010) else Color(0xFFE8F5E9) // Green
        else -> if (isDarkTheme) Color(0xFF3D1E00) else Color(0xFFFFF2ED) // Orange
    }

    // Header background colors for each meal type - adapted for dark theme
    val headerBackground = when (mealType.lowercase()) {
        "breakfast" -> if (isDarkTheme) Color(0xFF2C2700) else Color(0xFFFFFDE7) // Yellow
        "lunch" -> if (isDarkTheme) Color(0xFF002037) else Color(0xFFE8F5FF) // Blue
        "snacks" -> if (isDarkTheme) Color(0xFF6A1B9A) else Color(0xFFF3E5F5) // Purple
        "dinner" -> if (isDarkTheme) Color(0xFF002207) else Color(0xFFF1F8F1) // Green
        else -> if (isDarkTheme) Color(0xFF2C1500) else Color(0xFFFFF5F0) // Orange
    }

    // Text color for each meal type - keep as is for better contrast
    val mealTypeColor = when (mealType.lowercase()) {
        "breakfast" -> Color(0xFFFF9800) // Orange
        "lunch" -> Color(0xFF2196F3) // Blue
        "snacks" -> Color(0xFFAB47BC) // Purple
        "dinner" -> Color(0xFF4CAF50) // Green
        else -> Color(0xFFFF6B01) // Default orange
    }

    Card(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp),
        colors = CardDefaults.cardColors(containerColor = surfaceColor),
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
        shape = RoundedCornerShape(12.dp)
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
        ) {
            // Meal Type Header with colored background
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(headerBackground)
                    .padding(16.dp)
            ) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Box(
                        modifier = Modifier
                            .size(48.dp)
                            .clip(CircleShape)
                            .background(iconBackground),
                        contentAlignment = Alignment.Center
                    ) {
                        Text(
                            text = mealIcon,
                            fontSize = 24.sp
                        )
                    }

                    Column(
                        modifier = Modifier
                            .padding(start = 16.dp)
                            .weight(1f)
                    ) {
                        Text(
                            text = mealType.capitalize(),
                            fontSize = 20.sp,
                            fontWeight = FontWeight.Bold,
                            color = mealTypeColor,
                            fontFamily = poppinsFont
                        )
                        Text(
                            text = timeRange,
                            fontSize = 14.sp,
                            color = textSecondaryColor,
                            fontFamily = playfairFont
                        )
                    }

                }
            }

            Divider(
                color = dividerColor,
                thickness = 1.dp
            )

            // Menu Items with improved layout
            Column(
                modifier = Modifier.padding(16.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                // Convert meal items to a simpler format
                val allItems = mutableListOf<String>()

                meals.forEach { meal ->
                    allItems.addAll(meal.items)
                    allItems.addAll(meal.commonItems)

                    meal.hostels.forEach { (_, hostelItems) ->
                        allItems.addAll(hostelItems)
                    }
                }

                // Display unique items sorted alphabetically
                DishesGrid(
                    dishes = allItems.distinct().sorted(),
                    mealType = mealType,             // pass the corresponding meal type
                    isDarkTheme = isDarkTheme,       // pass the theme flag
                    modifier = Modifier              // optional modifier
                )



            }
        }
    }
}


@OptIn(ExperimentalLayoutApi::class)
@Composable
fun DishesGrid(
    dishes: List<String>,
    mealType: String,
    isDarkTheme: Boolean,
    modifier: Modifier = Modifier
) {
    FlowRow(
        modifier = modifier
            .fillMaxWidth()
            .padding(8.dp),
        horizontalArrangement = Arrangement.spacedBy(8.dp),
        verticalArrangement = Arrangement.spacedBy(8.dp),
        maxItemsInEachRow = 3
    ) {
        dishes.forEach { dish ->
            DishBox(
                dishName = dish,
                isDarkTheme = isDarkTheme,
                modifier = Modifier
            )
        }
    }
}

@Composable
fun DishBox(
    dishName: String,
    isDarkTheme: Boolean,
    modifier: Modifier = Modifier
) {
    val textColor = if (isDarkTheme) Color(0xFFE0E0E0) else Color(0xFF333333)
    val borderColor = if (isDarkTheme) Color(0xFF505050) else Color(0xFFE0E0E0)

    Surface(
        modifier = modifier,
        shape = RoundedCornerShape(14.dp),
        color = Color.Transparent,
        border = BorderStroke(1.dp, borderColor)
    ) {
        Text(
            text = dishName,
            fontSize = 15.sp, // Slightly larger for clarity
            fontWeight = FontWeight.SemiBold,
            color = textColor,
            lineHeight = 18.sp,
            maxLines = 2,
            overflow = TextOverflow.Ellipsis,
            modifier = Modifier.padding(horizontal = 12.dp, vertical = 8.dp),
            style = TextStyle(
                fontFamily = FontFamily.SansSerif
            )
        )
    }
}



// Extension function to capitalize first letter of a string
fun String.capitalize(): String {
    return this.replaceFirstChar {
        if (it.isLowerCase()) it.titlecase(Locale.getDefault())
        else it.toString()
    }
}


