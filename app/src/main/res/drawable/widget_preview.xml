<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background -->
    <item>
        <shape>
            <solid android:color="#F6F7FB" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#E2E8F0" />
        </shape>
    </item>

    <!-- Content Preview -->
    <item
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp">
        <layer-list>

            <!-- Header Area -->
            <item android:top="0dp" android:height="40dp">
                <layer-list>
                    <!-- Icon placeholder -->
                    <item android:width="24dp" android:height="24dp">
                        <shape android:shape="oval">
                            <solid android:color="#FF6B01" />
                        </shape>
                    </item>

                    <!-- Title area -->
                    <item android:left="32dp" android:top="4dp">
                        <shape>
                            <solid android:color="#FF6B01" />
                            <corners android:radius="4dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- First Meal Card -->
            <item android:top="50dp" android:height="60dp">
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#F1F5F9" />
                </shape>
            </item>

            <!-- Meal title in first card -->
            <item android:left="12dp" android:top="58dp" android:width="80dp" android:height="12dp">
                <shape>
                    <solid android:color="#FFB74D" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <!-- Meal items in first card -->
            <item android:left="12dp" android:top="76dp" android:right="12dp" android:height="8dp">
                <shape>
                    <solid android:color="#E2E8F0" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <item android:left="12dp" android:top="88dp" android:width="120dp" android:height="8dp">
                <shape>
                    <solid android:color="#E2E8F0" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <!-- Second Meal Card -->
            <item android:top="120dp" android:height="60dp">
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#F1F5F9" />
                </shape>
            </item>

            <!-- Meal title in second card -->
            <item android:left="12dp" android:top="128dp" android:width="60dp" android:height="12dp">
                <shape>
                    <solid android:color="#64B5F6" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <!-- Meal items in second card -->
            <item android:left="12dp" android:top="146dp" android:right="12dp" android:height="8dp">
                <shape>
                    <solid android:color="#E2E8F0" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

            <item android:left="12dp" android:top="158dp" android:width="100dp" android:height="8dp">
                <shape>
                    <solid android:color="#E2E8F0" />
                    <corners android:radius="2dp" />
                </shape>
            </item>

        </layer-list>
    </item>

</layer-list>